// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  bio           String?   @db.Text
  avatar        String?
  isCreator     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tracks        Track[]
  votes         Vote[]
  comments      Comment[]
  likedTracks   LikedTrack[]
  playlists     Playlist[]
  playHistory   PlayHistory[]
  hostedJams    Jam[]         @relation("JamHost")
  jamMemberships JamMember[]
  jamMessages   JamMessage[]

  @@index([username])
  @@index([email])
}

model Track {
  id            String    @id @default(cuid())
  title         String
  audioUrl      String
  coverUrl      String?
  genre         String
  duration      Int       @default(0) // in seconds
  playCount     Int       @default(0)
  
  creatorId     String
  creator       User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  votes         Vote[]
  comments      Comment[]
  likedBy       LikedTrack[]
  playlistTracks PlaylistTrack[]
  playHistory   PlayHistory[]
  jamTracks     JamTrack[]
  currentInJams Jam[]

  @@index([creatorId])
  @@index([genre])
  @@index([createdAt])
  @@index([playCount])
}

model Vote {
  id            String    @id @default(cuid())
  type          VoteType  // UP or DOWN
  
  trackId       String
  track         Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())

  @@unique([trackId, userId])
  @@index([trackId])
  @@index([userId])
}

enum VoteType {
  UP
  DOWN
}

model Comment {
  id            String    @id @default(cuid())
  content       String    @db.Text
  
  trackId       String
  track         Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([trackId])
  @@index([userId])
  @@index([createdAt])
}

model LikedTrack {
  id            String    @id @default(cuid())
  
  trackId       String
  track         Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())

  @@unique([trackId, userId])
  @@index([userId])
  @@index([trackId])
}

model Playlist {
  id            String    @id @default(cuid())
  name          String
  description   String?   @db.Text
  coverUrl      String?
  isPublic      Boolean   @default(true)
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tracks        PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id            String    @id @default(cuid())
  position      Int       @default(0)
  
  playlistId    String
  playlist      Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  
  trackId       String
  track         Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  addedAt       DateTime  @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
}

model PlayHistory {
  id            String    @id @default(cuid())
  
  trackId       String
  track         Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  playedAt      DateTime  @default(now())

  @@index([userId, playedAt])
  @@index([trackId])
}
model Jam {
  id            String    @id @default(cuid())
  name          String
  isPublic      Boolean   @default(true)
  roomCode      String?   @unique // 6 digit code for private rooms
  
  hostId        String
  host          User      @relation("JamHost", fields: [hostId], references: [id], onDelete: Cascade)
  
  currentTrackId String?
  currentTrack   Track?    @relation(fields: [currentTrackId], references: [id])
  
  isPlaying     Boolean   @default(false)
  seekPosition  Float     @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  members       JamMember[]
  queue         JamTrack[]
  messages      JamMessage[]

  @@index([hostId])
  @@index([roomCode])
}

model JamMember {
  id        String   @id @default(cuid())
  jamId     String
  jam       Jam      @relation(fields: [jamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      JamRole  @default(LISTENER)
  joinedAt  DateTime @default(now())

  @@unique([jamId, userId])
  @@index([jamId])
  @@index([userId])
}

enum JamRole {
  HOST
  LISTENER
}

model JamTrack {
  id        String   @id @default(cuid())
  jamId     String
  jam       Jam      @relation(fields: [jamId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  addedAt   DateTime @default(now())

  @@index([jamId])
  @@index([trackId])
}

model JamMessage {
  id        String   @id @default(cuid())
  jamId     String
  jam       Jam      @relation(fields: [jamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([jamId])
  @@index([userId])
}
